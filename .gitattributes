# Normalise line endings in the repository. Without this, a Windows checkout
# commits CRLF and every file looks rewritten to anyone on Linux or macOS.
* text=auto eol=lf

# Shell scripts must keep LF or they will not run under bash.
*.sh text eol=lf

# Binary, never diffed or converted.
*.png binary
*.jpg binary
*.exe binary
*.jar binary
